{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "老子今天又赚 200",
  "version": "1.0.0",
  "identifier": "com.salarytracker.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "../index.html",
    "beforeBuildCommand": "",
    "frontendDist": ".."
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "老子今天又赚 200",
        "width": 420,
        "height": 700,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "decorations": true,
        "transparent": false,
        "center": false,
        "x": 100,
        "y": 100
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
